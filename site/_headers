/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; manifest-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://api.github.com; script-src 'self' https://static.cloudflareinsights.com; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=604800, immutable

# Long-lived cache for CSS/JS: bump ?v= on every href/src in index.html & 404.html when that file changes.
/css/*
  Cache-Control: public, max-age=604800, immutable

/js/*
  Cache-Control: public, max-age=604800, immutable

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/assets/screens/manifest.json
  Content-Type: application/json
  Cache-Control: public, max-age=86400

/site.webmanifest.en.json
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400
